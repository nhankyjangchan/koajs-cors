{
    "experimentalTernaries": true,
    "experimentalOperatorPosition": "start",
    "printWidth": 96,
    "tabWidth": 4,
    "useTabs": false,
    "semi": true,
    "singleQuote": true,
    "quoteProps": "as-needed",
    "trailingComma": "none",
    "bracketSpacing": true,
    "objectWrap": "preserve",
    "arrowParens": "always",
    "requirePragma": false,
    "insertPragma": false,
    "checkIgnorePragma": false,
    "proseWrap": "preserve",
    "endOfLine": "lf"
}
